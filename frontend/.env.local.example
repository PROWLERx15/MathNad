# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Database (Supabase Postgres via Prisma)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Contract
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz

# Backend signer (same wallet as VERIFIER in contract)
SIGNER_PRIVATE_KEY=

# Pyth Entropy
PYTH_ENTROPY_ADDRESS=0x825c0390f379c631f3cf11a82a37d20bddf93c07

# Base URL for internal API calls from WS server
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebSocket server URL (Render). Omit for same-origin WS in custom server mode.
# NEXT_PUBLIC_WS_URL=wss://your-ws-server.onrender.com
